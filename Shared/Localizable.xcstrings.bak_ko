    "help.widget": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主屏空白处，添加小号「倒数日」小组件。它会自动跟随首页首卡，你也可以从日期详情指定一张卡。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Home Screen to add the small DayCount widget. It follows your first card until you select a date in its details."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按主畫面空白處，新增小號「倒數日」小工具。它會自動跟隨首頁首卡，也可以從日期詳情指定一張卡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面を長押しすると、DayCountの小さいウィジェットを追加できます。詳細で日付を選ぶまでは、最初のカードを表示します。"
          }
        }
      }
    },
    "help.reminders": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日期详情开启当天提醒。提醒在你的当地时间上午 9 点送达，开启时需要通知权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on a same-day reminder in Date Details. It uses 9 a.m. local time and requires notification permission."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在日期詳情開啟當天提醒。提醒於當地上午 9 點送達，開啟時需要通知權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「日付の詳細」で当日の通知をオンにできます。現地時間の午前9時に届き、通知の許可が必要です。"
          }
        }
      }
    },
    "help.import": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 .datecard 文件，或在首页「更多」中粘贴导入口令。检查日期后点添加。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a .datecard file or paste an import code from More. Check the date, then tap Add."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 .datecard 檔案，或在首頁「更多」貼上匯入口令。檢查日期後點新增。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「その他」から.datecardファイルを開くか、取り込みコードを貼り付けます。日付を確認して「追加」をタップしてください。"
          }
        }
      }
